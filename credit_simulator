#!/usr/bin/env bash
#
# Runs the credit simulator.
#
#   ./credit_simulator                    interactive mode
#   ./credit_simulator file_inputs.txt    read commands from a file
#
# The jar is built with Maven on first use and rebuilt whenever the sources change.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAR="$ROOT_DIR/target/credit_simulator.jar"

if ! command -v java >/dev/null 2>&1; then
    echo "Error: Java 17 or newer is required but 'java' was not found on PATH." >&2
    exit 127
fi

needs_build() {
    [[ ! -f "$JAR" ]] && return 0
    [[ -n "$(find "$ROOT_DIR/pom.xml" "$ROOT_DIR/src/main" -newer "$JAR" -print -quit 2>/dev/null)" ]]
}

if needs_build; then
    if ! command -v mvn >/dev/null 2>&1; then
        echo "Error: $JAR is missing and Maven ('mvn') is not installed to build it." >&2
        exit 127
    fi
    echo "Building credit_simulator..." >&2
    mvn -q -B -f "$ROOT_DIR/pom.xml" -DskipTests package >&2
fi

exec java -jar "$JAR" "$@"
